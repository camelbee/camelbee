<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.camelbee</groupId>
        <artifactId>camelbee-springboot-dependencies</artifactId>
        <version>4.0.0</version>
        <relativePath>../../dependencies/springboot/pom.xml</relativePath>
    </parent>

    <name>CamelBee SpringBoot Core</name>
    <artifactId>camelbee-springboot-core</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!--
          Published for consumers still on JDK 17 (Quarkus 3.15 LTS / Spring Boot 3.3-3.4 shops
          commonly are). The parent compiles with <release>, so touching a post-17 JDK API fails
          the build here rather than at runtime on the consumer's JVM. Starters and samples stay
          on 21 - only the artifacts people put on their own classpath need to be 17.
        -->
        <java.version>17</java.version>
        <!-- Line coverage ~80%; gate held at 0.80. -->
        <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
    </properties>

    <dependencies>
        <!-- The framework-neutral CamelBee engine: tracing, topology, redaction, logging.
             DI wiring and the HTTP layer stay in this module. -->
        <dependency>
            <groupId>io.camelbee</groupId>
            <artifactId>camelbee-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          'provided', matching camelbee-core and the Quarkus/standalone cores: a Spring Boot + Camel
          application already supplies both, at its own versions. At compile scope this module's POM
          would advertise the Spring Boot / Camel versions of THIS build as transitives, which a
          consumer on an older stack then has to out-manage. Provided keeps them off the consumer's
          graph entirely, so their BOM is the only thing deciding.

          Consequence: core-as-a-dependency users must declare spring-boot-starter-web and
          camel-spring-boot-starter themselves - documented in README Option 1. Users of
          camelbee-springboot-starter are unaffected; the starter declares both.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-servlet-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-http-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-jackson-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-transports-http-jetty</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-test-spring-junit6</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-ui-dist</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/camelbee</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../ui/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
