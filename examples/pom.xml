<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
      <groupId>io.camelbee</groupId>
      <artifactId>parent</artifactId>
      <version>4.0.0</version>
      <relativePath>../parent/pom.xml</relativePath>
    </parent>

    <artifactId>examples</artifactId>
    <packaging>pom</packaging>

  <name>CamelBee</name>
  <description>CamelBee Starters</description>

  <modules>
      <module>allcomponent-quarkus-sample</module>
      <module>allcomponent-springboot-sample</module>
      <module>allcomponent-standalone-sample</module>
      <!--
        README Option 1 (core as a dependency), one per runtime, each pinned to the OLDEST stack the
        version table claims. The allcomponent-* samples above all inherit from a CamelBee starter,
        so they exercise Option 2 only - these are the sole coverage of the option the README calls
        recommended, and the only thing that keeps the published version floors honest.

        They are aggregated here but do NOT inherit from this POM: each stands alone with its own
        BOMs and plugin versions, the way a real consuming project does. Aggregation and inheritance
        are separate in Maven, and the independence is the point.
      -->
      <module>core-only-quarkus-sample</module>
      <module>core-only-springboot-sample</module>
      <module>core-only-standalone-sample</module>
  </modules>

</project>
